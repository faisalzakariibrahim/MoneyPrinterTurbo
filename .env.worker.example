# --- Supabase (service role: server-side only, never in the browser) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Storage S3 endpoint (Project Settings -> Storage -> S3) for multi-GB renders
S3_ENDPOINT=https://YOUR-PROJECT.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=longform
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI ---
ANTHROPIC_API_KEY=
LF_SCRIPT_MODEL=claude-sonnet-5-5
LF_ANALYSIS_MODEL=claude-sonnet-5-5
LF_FAST_MODEL=claude-haiku-5-5
ELEVENLABS_API_KEY=

# --- YouTube OAuth client (same as the web app) + token encryption key (32 bytes base64, same as web) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LF_TOKEN_ENC_KEY=

# --- Worker tuning ---
# Split workers: one "light" service (train_niche,script,publish; concurrency 4-8)
# and one or more "render" services on big CPU/GPU boxes.
LF_WORKER_TYPES=train_niche,script,render,publish
LF_WORKER_CONCURRENCY=1
LF_RENDER_WORKERS=2
LF_CHUNK_SECONDS=300
LF_VIDEO_CODEC=libx264
LF_X264_PRESET=veryfast
LF_WHISPER_MODEL=small.en
# Optional residential proxy if YouTube blocks transcript fetches from your host
LF_YT_PROXY=
